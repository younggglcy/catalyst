{
  "name": "catalyst",
  "type": "module",
  "version": "0.0.0",
  "description": "A tool that assists in updating pnpm catalogs",
  "author": {
    "name": "younggglcy",
    "email": "younggglcy@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/younggglcy/catalyst#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/younggglcy/catalyst.git"
  },
  "bugs": "https://github.com/younggglcy/catalyst/issues",
  "keywords": [
    "pnpm",
    "catalog",
    "catalogs"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "bin": {
    "catalyst": "./bin/catalyst.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "rolldown -c rolldown.config.ts -w",
    "build": "rolldown -c rolldown.config.ts"
  },
  "dependencies": {
    "citty": "^0.1.6",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.3.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.1",
    "lint-staged": "^15.4.3",
    "rolldown": "1.0.0-beta.3",
    "simple-git-hooks": "^2.11.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
